{
  "manifest_version": 3,
  "name": "Folio 文献收藏",
  "version": "1.1.3",
  "description": "将网页论文和 PDF 收藏到本机 Folio。",
  "minimum_chrome_version": "109",
  "key": "",
  "icons": {
    "256": "icons/folio-icon.png"
  },
  "permissions": [
    "activeTab",
    "nativeMessaging",
    "scripting",
    "alarms"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "收藏到 Folio",
    "default_icon": "icons/folio-icon.png",
    "default_popup": "popup.html"
  }
}
