<?xml version="1.0" encoding="UTF-8"?>
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="TaskPaneApp">
  <Id>A032B8CE-4D6B-43F1-A14C-53E89C1D5114</Id>
  <Version>1.0.1.0</Version>
  <ProviderName>Folio</ProviderName>
  <DefaultLocale>zh-CN</DefaultLocale>
  <DisplayName DefaultValue="Folio 引用"/>
  <Description DefaultValue="在 Word 中插入和刷新 Folio 文献引用。"/>
  <IconUrl DefaultValue="https://localhost:37862/assets/folio-icon.png"/>
  <HighResolutionIconUrl DefaultValue="https://localhost:37862/assets/folio-icon.png"/>
  <SupportUrl DefaultValue="https://github.com/G-mas66/folio/issues"/>
  <AppDomains><AppDomain>https://localhost:37862</AppDomain></AppDomains>
  <Hosts><Host Name="Document"/></Hosts>
  <Requirements><Sets DefaultMinVersion="1.1"><Set Name="WordApi" MinVersion="1.1"/></Sets></Requirements>
  <DefaultSettings>
    <SourceLocation DefaultValue="https://localhost:37862/taskpane.html"/>
  </DefaultSettings>
  <Permissions>ReadWriteDocument</Permissions>
  <VersionOverrides xmlns="http://schemas.microsoft.com/office/taskpaneappversionoverrides" xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0" xsi:type="VersionOverridesV1_0">
    <Requirements><bt:Sets DefaultMinVersion="1.1"><bt:Set Name="AddinCommands"/></bt:Sets></Requirements>
    <Hosts>
      <Host xsi:type="Document">
        <DesktopFormFactor>
          <FunctionFile resid="Folio.Commands.Url"/>
          <ExtensionPoint xsi:type="PrimaryCommandSurface">
            <CustomTab id="Folio.Tab">
              <Group id="Folio.Citations.Group">
                <Label resid="Folio.Group.Label"/>
                <Icon><bt:Image size="16" resid="Folio.Icon"/><bt:Image size="32" resid="Folio.Icon"/><bt:Image size="80" resid="Folio.Icon"/></Icon>
                <Control xsi:type="Button" id="Folio.Insert">
                  <Label resid="Folio.Insert.Label"/>
                  <Supertip><Title resid="Folio.Insert.Label"/><Description resid="Folio.Insert.Description"/></Supertip>
                  <Icon><bt:Image size="16" resid="Folio.Icon"/><bt:Image size="32" resid="Folio.Icon"/><bt:Image size="80" resid="Folio.Icon"/></Icon>
                  <Action xsi:type="ShowTaskpane"><TaskpaneId>Folio.Citations.Pane</TaskpaneId><SourceLocation resid="Folio.Pane.Url"/></Action>
                </Control>
                <Control xsi:type="Button" id="Folio.Refresh">
                  <Label resid="Folio.Refresh.Label"/>
                  <Supertip><Title resid="Folio.Refresh.Label"/><Description resid="Folio.Refresh.Description"/></Supertip>
                  <Icon><bt:Image size="16" resid="Folio.Icon"/><bt:Image size="32" resid="Folio.Icon"/><bt:Image size="80" resid="Folio.Icon"/></Icon>
                  <Action xsi:type="ExecuteFunction"><FunctionName>folioRefreshDocument</FunctionName></Action>
                </Control>
                <Control xsi:type="Button" id="Folio.Style">
                  <Label resid="Folio.Style.Label"/>
                  <Supertip><Title resid="Folio.Style.Label"/><Description resid="Folio.Style.Description"/></Supertip>
                  <Icon><bt:Image size="16" resid="Folio.Icon"/><bt:Image size="32" resid="Folio.Icon"/><bt:Image size="80" resid="Folio.Icon"/></Icon>
                  <Action xsi:type="ShowTaskpane"><TaskpaneId>Folio.Citations.Pane</TaskpaneId><SourceLocation resid="Folio.Style.Url"/></Action>
                </Control>
              </Group>
              <Label resid="Folio.Tab.Label"/>
            </CustomTab>
          </ExtensionPoint>
        </DesktopFormFactor>
      </Host>
    </Hosts>
    <Resources>
      <bt:Images><bt:Image id="Folio.Icon" DefaultValue="https://localhost:37862/assets/folio-icon.png"/></bt:Images>
      <bt:Urls>
        <bt:Url id="Folio.Pane.Url" DefaultValue="https://localhost:37862/taskpane.html"/>
        <bt:Url id="Folio.Style.Url" DefaultValue="https://localhost:37862/taskpane.html?section=style"/>
        <bt:Url id="Folio.Commands.Url" DefaultValue="https://localhost:37862/taskpane.html?mode=commands"/>
      </bt:Urls>
      <bt:ShortStrings>
        <bt:String id="Folio.Tab.Label" DefaultValue="Folio"/>
        <bt:String id="Folio.Group.Label" DefaultValue="文献引用"/>
        <bt:String id="Folio.Insert.Label" DefaultValue="插入引用"/>
        <bt:String id="Folio.Refresh.Label" DefaultValue="刷新引用与书目"/>
        <bt:String id="Folio.Style.Label" DefaultValue="引用格式"/>
      </bt:ShortStrings>
      <bt:LongStrings>
        <bt:String id="Folio.Insert.Description" DefaultValue="搜索 Folio 文献并插入引用。"/>
        <bt:String id="Folio.Refresh.Description" DefaultValue="更新书目信息并刷新文档引用与参考文献。"/>
        <bt:String id="Folio.Style.Description" DefaultValue="选择 APA 7 或 GB/T 7714-2015 引用格式。"/>
      </bt:LongStrings>
    </Resources>
  </VersionOverrides>
</OfficeApp>
