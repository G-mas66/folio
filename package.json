{
  "name": "paper-workbench",
  "version": "0.11.0",
  "private": true,
  "description": "阅川 Folio 个人文献阅读工作台",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && cross-env WORKBENCH_DEV=1 electron .\"",
    "build:ui": "tsc -b && vite build",
    "start": "electron .",
    "build:backend": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-backend.ps1",
    "build:pdf-engine": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-pdf-engine.ps1",
    "dist": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dist.ps1 -Target nsis",
    "dist:portable": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dist.ps1 -Target portable",
    "test:backend": ".venv\\Scripts\\python.exe -m unittest review.test_pdf_contract review.test_api_contract review.test_translation_flow review.test_chat_context review.test_free_provider_contract review.test_delete_contract review.test_pdf_upgrade_contract review.test_tool_chat_contract review.test_folder_contract review.test_model_discovery_contract review.test_model_auto_discovery review.test_stream_parser review.test_stream_contract review.test_stream_upgrade review.test_web_search_contract review.test_notes_contract review.test_storage_identity backend_tests.test_glossary_contract -v",
    "test:storage": "node review/test_storage_location.cjs"
  },
  "dependencies": {
    "katex": "0.19.0",
    "pdfjs-dist": "6.2.108",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-markdown": "^10.1.0",
    "rehype-katex": "7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "6.0.0"
  },
  "overrides": {
    "katex": "$katex"
  },
  "devDependencies": {
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^9.2.1",
    "cross-env": "^10.0.0",
    "electron": "^38.1.2",
    "electron-builder": "^26.0.12",
    "typescript": "^5.9.2",
    "vite": "^7.1.5",
    "wait-on": "^8.0.4"
  },
  "build": {
    "appId": "local.paperworkbench.desktop",
    "productName": "阅川 Folio",
    "directories": {
      "output": "dist/installer"
    },
    "files": [
      "dist/**",
      "assets/**",
      "electron/**",
      "package.json",
      "!dist/installer*/**"
    ],
    "extraResources": [
      {
        "from": "backend/dist/workbench-service.exe",
        "to": "backend/workbench-service.exe"
      },
      {
        "from": "backend/dist/workbench-pdf-engine",
        "to": "pdf-engine"
      },
      {
        "from": "backend/pdf_engine_assets/babeldoc",
        "to": "pdf-engine-assets/babeldoc"
      },
      {
        "from": "backend/pdf-engine-source",
        "to": "pdf-engine-source"
      },
      {
        "from": "THIRD-PARTY-NOTICES.md",
        "to": "THIRD-PARTY-NOTICES.md"
      }
    ],
    "win": {
      "icon": "assets/folio-icon.ico",
      "target": [
        "nsis"
      ],
      "artifactName": "阅川-Folio-${version}-安装程序.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "阅川 Folio",
      "installerLanguages": [
        "zh_CN"
      ],
      "include": "scripts/installer.nsh"
    }
  }
}
